public class Student {

    int id;
    String name;

    void display() {
        System.out.println("Student ID: " + id);
        System.out.println("Student Name: " + name);
    }

    public static void main(String[] args) {
        Student s1 = new Student();

        s1.id = 5132;
        s1.name = "Thanush";

        s1.display();
    }
}

