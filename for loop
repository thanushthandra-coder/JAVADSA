9. Count the occurrence of a specific number.

import java.util.Arrays;

public class CountOccurrence {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 20, 40, 20, 50};
        int key = 20;

        long count = Arrays.stream(arr)
                           .filter(n -> n == key)
                           .count();

